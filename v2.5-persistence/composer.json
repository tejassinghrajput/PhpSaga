{
    "name": "phpsaga/persistence",
    "description": "Database persistence for PhpSaga audit logs",
    "require": {
        "php": "^8.1",
        "phpsaga/phpsaga": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PhpSaga\\Persistence\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../v1-php-core"
        }
    ]
}
