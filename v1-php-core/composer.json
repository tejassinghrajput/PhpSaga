{
    "name": "phpsaga/phpsaga",
    "description": "Transactional execution for any PHP function",
    "type": "library",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PhpSaga\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSaga\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
