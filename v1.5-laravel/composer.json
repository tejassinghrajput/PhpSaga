{
    "name": "phpsaga/laravel",
    "description": "Laravel integration for PhpSaga",
    "require": {
        "php": "^8.1",
        "phpsaga/phpsaga": "dev-main",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/events": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpSaga\\Laravel\\PhpSagaServiceProvider"
            ],
            "aliases": {
                "Saga": "PhpSaga\\Laravel\\Facades\\Saga"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "PhpSaga\\Laravel\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../v1-php-core"
        }
    ]
}
